<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Action Vaccins -->
    <record id="action_tp_vaccin" model="ir.actions.act_window">
        <field name="name">Vaccins</field>
        <field name="res_model">tp.vaccin</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Vaccins -->
    <menuitem
        id="menu_tp_vaccins"
        name="Vaccins"
        parent="menu_tp_root"
        action="action_tp_vaccin"
        sequence="20"/>

    <!-- Vue liste -->
    <record id="view_tp_vaccin_tree" model="ir.ui.view">
        <field name="name">tp.vaccin.tree</field>
        <field name="model">tp.vaccin</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="animal_id"/>
                <field name="date_vaccination"/>
            </tree>
        </field>
    </record>

    <!-- Vue formulaire -->
    <record id="view_tp_vaccin_form" model="ir.ui.view">
        <field name="name">tp.vaccin.form</field>
        <field name="model">tp.vaccin</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="animal_id"/>
                        <field name="date_vaccination"/>
                        <field name="veterinaire"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
